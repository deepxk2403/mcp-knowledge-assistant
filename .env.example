# Fully-free stack: local embeddings (no key) + OpenRouter agent.

# Required: free OpenRouter key for the agent LLM -> https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...

# Optional: override the OpenRouter model (must support tool calling)
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Optional: Tavily key for the search_web tool (has a free tier)
TAVILY_API_KEY=tvly-...

# Local embedding model (no key needed). Override only if you want a different one.
# EMBED_MODEL=BAAI/bge-small-en-v1.5

QDRANT_URL=http://localhost:6333
